{
  "name": "@kuroshio-lab/ui",
  "version": "0.2.4",
  "description": "Radix UI-based component library for Kuroshio Lab",
  "private": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./button": {
      "import": "./dist/button.js",
      "types": "./dist/button.d.ts"
    },
    "./card": {
      "import": "./dist/card.js",
      "types": "./dist/card.d.ts"
    },
    "./dialog": {
      "import": "./dist/dialog.js",
      "types": "./dist/dialog.d.ts"
    },
    "./form": {
      "import": "./dist/form.js",
      "types": "./dist/form.d.ts"
    },
    "./input": {
      "import": "./dist/input.js",
      "types": "./dist/input.d.ts"
    },
    "./label": {
      "import": "./dist/label.js",
      "types": "./dist/label.d.ts"
    },
    "./select": {
      "import": "./dist/select.js",
      "types": "./dist/select.d.ts"
    },
    "./badge": {
      "import": "./dist/badge.js",
      "types": "./dist/badge.d.ts"
    },
    "./scroll-area": {
      "import": "./dist/scroll-area.js",
      "types": "./dist/scroll-area.d.ts"
    },
    "./separator": {
      "import": "./dist/separator.js",
      "types": "./dist/separator.d.ts"
    },
    "./textarea": {
      "import": "./dist/textarea.js",
      "types": "./dist/textarea.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run flatten-dist",
    "flatten-dist": "node -e \"const fs = require('fs'); const path = require('path'); const src = 'dist/ui/src'; if(fs.existsSync(src)) { fs.readdirSync(src).forEach(f => fs.copyFileSync(path.join(src, f), path.join('dist', f))); } const stylessrc = 'dist/styles'; if(fs.existsSync(stylessrc)) { fs.rmSync(stylessrc, { recursive: true }); }\"",
    "dev": "tsc --watch",
    "lint": "prettier --check src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.574.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.66.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18"
  }
}
